ML_ENV=dev
ML_LOG_LEVEL=info
ML_LISTEN_ADDR=:7002
ML_ADMIN_ADDR=127.0.0.1:7003
ML_BASE_DOMAIN=localtest.me
ML_PUBLIC_SCHEME=http
ML_PUBLIC_PORT=7002
ML_TRUST_PROXY=false
# Leave empty to use the in-memory store (single node, dev only)
ML_REDIS_URL=redis://localhost:6379/0
ML_JWT_PUBLIC_KEYS=keys/ed25519.pub
ML_JWT_ISSUER=mylocalon-platform
ML_JWT_AUDIENCE=mylocalon-gateway
ML_HEARTBEAT_INTERVAL=15s
ML_HEARTBEAT_TIMEOUT=45s
ML_RESUME_GRACE=30s
ML_REQUEST_TIMEOUT=35s
ML_MAX_BODY_BYTES=10485760
ML_MAX_TUNNELS_PER_USER=5
ML_CONN_RATE_PER_MIN=30
ML_REQ_RATE_PER_SEC=100
# Platform link. With ML_JWKS_URL set, ML_JWT_PUBLIC_KEYS becomes an optional fallback.
ML_JWKS_URL=
ML_PLATFORM_URL=
# Same value as the platform's INTERNAL_API_TOKEN (openssl rand -hex 32)
ML_INTERNAL_TOKEN=
ML_IP_REQ_RATE_PER_SEC=50
# Operator takedowns, comma-separated
ML_BLOCKED_SUBDOMAINS=
